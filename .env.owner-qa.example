# Template only. Keep real values in ignored .env.owner-qa.local or private shell env.
# Expo dotenv is disabled for the owner-only release workflow to prevent .env fallback.
EXPO_NO_DOTENV=1
EXPO_PUBLIC_BUILD_VARIANT=owner-qa
EAS_BUILD_PLATFORM=ios
# Must exactly match the separately verified config/owner-qa-release.json project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set a fresh build number after checking App Store Connect (last observed: 13).
OWNER_QA_BUILD_NUMBER=
EXPO_PUBLIC_MAPBOX_TOKEN=
MAPBOX_DOWNLOAD_TOKEN=
