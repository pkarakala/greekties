# Copy this file to `.env` and fill in the values. Never commit `.env`.
# See docs/SIMULATOR_SETUP.md (local runs) and docs/LAUNCH_RUNBOOK.md §B (EAS).

# Supabase project URL (public; prefilled — used by lib/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=https://sdscrvoorrygesrhjeee.supabase.co

# Supabase anon key (public API key, safe to embed ONLY because RLS is
# enforced server-side). Dashboard → Settings → API Keys → "anon public".
# Required — the app shows the missing-.env screen without it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox PUBLIC token (pk.*) for runtime map rendering (app/map.tsx).
# account.mapbox.com → Access tokens. Optional — map degrades gracefully.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Mapbox DOWNLOAD token (sk.*, DOWNLOADS:READ scope) — build-time secret read
# by app.config.ts so CocoaPods/Gradle can fetch the native Mapbox SDK during
# native builds. NOT an EXPO_PUBLIC_ var: it must never ship in the JS bundle.
# Set it here only for local prebuild/pod install; on EAS store it as a SECRET
# environment variable (see docs/APP_STORE_CHECKLIST.md §2/§4).
# Not needed for Expo Go or plain `expo start`.
MAPBOX_DOWNLOAD_TOKEN=
